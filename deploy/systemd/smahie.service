# Install to /etc/systemd/system/smahie.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now smahie
[Unit]
Description=SMAHIE ORTHO CARE website (FastAPI/Uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=smahie
Group=smahie
WorkingDirectory=/srv/smahie
EnvironmentFile=/srv/smahie/.env
ExecStart=/srv/smahie/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 2 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --no-access-log
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/smahie
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
